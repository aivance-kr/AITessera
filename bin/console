#!/usr/bin/env php
<?php

declare(strict_types=1);

// AITessera CLI 진입점.
// phinx 마이그레이션 위임 + 애플리케이션 커맨드(큐 컨슈머 등)를 지원한다.

use App\Console\CreateOperator;
use App\Console\GenerateDailyLogReport;
use App\Console\GenerateSecurityReport;
use App\Console\ProcessLoginAnomaly;
use App\Console\ProcessLogQueue;
use App\Console\ProcessMailQueue;
use App\Support\ContainerFactory;
use App\Exception\ValidationException;
use App\Support\JwtKeyGenerator;
use Dotenv\Dotenv;

require dirname(__DIR__) . '/vendor/autoload.php';

Dotenv::createImmutable(dirname(__DIR__))->safeLoad();

$command = $argv[1] ?? 'list';

$runPhinx = static function (array $args): int {
    $bin  = dirname(__DIR__) . '/vendor/bin/phinx';
    $conf = dirname(__DIR__) . '/phinx.php';
    $cmd  = escapeshellarg($bin) . ' ' . implode(' ', array_map('escapeshellarg', $args))
        . ' -c ' . escapeshellarg($conf);
    passthru($cmd, $exitCode);

    return $exitCode;
};

$usage = static function (): int {
    fwrite(STDOUT, <<<TXT
    AITessera 콘솔

    사용법:
      php bin/console <command>

    사용 가능한 커맨드:
      migrate     대기 중인 마이그레이션 실행
      rollback    마지막 마이그레이션 롤백
      seed:run    시더 실행
      mail:work   메일 큐 컨슈머 (큐를 비우고 종료)
      log:work    로그 큐 컨슈머 (큐를 비우고 종료)
      security:scan 로그인 이벤트 큐 소비 → 이상 스코어링·기록 (큐를 비우고 종료)
      report:daily 전일 로그 집계 → AI 일일 리포트 생성 → 메일 큐 적재
      report:security 전일 로그인 이벤트 보안 집계 → AI 보안 리포트 생성 → 메일 큐 적재
      jwt:keygen  RS256 서명용 RSA 키페어 생성 (--force 로 덮어쓰기)
      operator:create 최초 운영자 계정 생성 (--email= --name= --affiliation= --contact= [--company=], 비밀번호는 입력 프롬프트/표준입력)

    TXT);

    return 0;
};

$jwtKeygen = static function (array $argv): int {
    // 저장 경로는 .env 의 JWT_PRIVATE_KEY_PATH·JWT_PUBLIC_KEY_PATH 를 우선 사용하고, 없으면 var/keys 기본값.
    $root = dirname(__DIR__);
    $privatePath = ($_ENV['JWT_PRIVATE_KEY_PATH'] ?? '') ?: $root . '/var/keys/jwt_private.pem';
    $publicPath  = ($_ENV['JWT_PUBLIC_KEY_PATH'] ?? '') ?: $root . '/var/keys/jwt_public.pem';
    $force = in_array('--force', $argv, true);

    try {
        $generator = ContainerFactory::build()->get(JwtKeyGenerator::class);
        assert($generator instanceof JwtKeyGenerator);
        $result = $generator->generate($privatePath, $publicPath, force: $force);
    } catch (Throwable $e) {
        fwrite(STDERR, "키 생성 실패: {$e->getMessage()}\n");

        return 1;
    }

    fwrite(STDOUT, <<<TXT
    RSA 키페어 생성 완료 ({$result['bits']} 비트)
      개인키: {$result['privateKeyPath']}
      공개키: {$result['publicKeyPath']}

    .env 에 아래를 설정하세요:
      JWT_ALGO=RS256
      JWT_PRIVATE_KEY_PATH={$result['privateKeyPath']}
      JWT_PUBLIC_KEY_PATH={$result['publicKeyPath']}

    ⚠ 개인키는 절대 커밋하지 마세요. 운영은 SSM/Secrets Manager 로 배치하세요.

    TXT);

    return 0;
};

$mailWork = static function (): int {
    $worker = ContainerFactory::build()->get(ProcessMailQueue::class);
    assert($worker instanceof ProcessMailQueue);
    $count = $worker->run();
    fwrite(STDOUT, "메일 {$count}건 처리 완료\n");

    return 0;
};

$logWork = static function (): int {
    $worker = ContainerFactory::build()->get(ProcessLogQueue::class);
    assert($worker instanceof ProcessLogQueue);
    $count = $worker->run();
    fwrite(STDOUT, "로그 {$count}건 처리 완료\n");

    return 0;
};

$securityScan = static function (): int {
    $worker = ContainerFactory::build()->get(ProcessLoginAnomaly::class);
    assert($worker instanceof ProcessLoginAnomaly);
    $count = $worker->run();
    fwrite(STDOUT, "로그인 이벤트 {$count}건 스코어링 완료\n");

    return 0;
};

$reportDaily = static function (): int {
    $worker = ContainerFactory::build()->get(GenerateDailyLogReport::class);
    assert($worker instanceof GenerateDailyLogReport);
    $count = $worker->run();
    $message = $count > 0
        ? '일일 로그 리포트를 메일 큐에 적재했습니다.'
        : '수신자(LOG_REPORT_RECIPIENT) 미설정 — 리포트 발송을 건너뜁니다.';
    fwrite(STDOUT, $message . "\n");

    return 0;
};

$reportSecurity = static function (): int {
    $worker = ContainerFactory::build()->get(GenerateSecurityReport::class);
    assert($worker instanceof GenerateSecurityReport);
    $count = $worker->run();
    $message = $count > 0
        ? '일일 보안 리포트를 메일 큐에 적재했습니다.'
        : '수신자(SECURITY_ALERT_RECIPIENT·LOG_REPORT_RECIPIENT) 미설정 — 리포트 발송을 건너뜁니다.';
    fwrite(STDOUT, $message . "\n");

    return 0;
};

$operatorCreate = static function (array $argv): int {
    // 비밀번호는 셸 히스토리·ps 에 남지 않도록 인자로 받지 않는다.
    // 터미널이면 화면에 표시하지 않고 두 번 입력받고, 파이프면 표준입력 첫 줄을 읽는다.
    $isTty = function_exists('posix_isatty') && posix_isatty(STDIN);
    $readSecret = static function (string $prompt) use ($isTty): string {
        if ($isTty) {
            fwrite(STDOUT, $prompt);
            shell_exec('stty -echo');
        }
        $line = fgets(STDIN);
        if ($isTty) {
            shell_exec('stty echo');
            fwrite(STDOUT, "\n");
        }

        return rtrim($line === false ? '' : $line, "\r\n");
    };

    $password = $readSecret('비밀번호: ');
    if ($isTty && $readSecret('비밀번호 확인: ') !== $password) {
        fwrite(STDERR, "비밀번호가 일치하지 않습니다.\n");

        return 1;
    }

    try {
        $command = ContainerFactory::build()->get(CreateOperator::class);
        assert($command instanceof CreateOperator);
        fwrite(STDOUT, $command->run(CreateOperator::parseOptions($argv), $password) . "\n");
    } catch (ValidationException $e) {
        fwrite(STDERR, "입력값 오류:\n  - " . implode("\n  - ", $e->errors()) . "\n");

        return 1;
    } catch (Throwable $e) {
        fwrite(STDERR, "운영자 생성 실패: {$e->getMessage()}\n");

        return 1;
    }

    return 0;
};

$exitCode = match ($command) {
    'migrate'          => $runPhinx(['migrate']),
    'rollback'         => $runPhinx(['rollback']),
    'seed:run'         => $runPhinx(['seed:run']),
    'mail:work'        => $mailWork(),
    'log:work'         => $logWork(),
    'security:scan'    => $securityScan(),
    'report:daily'     => $reportDaily(),
    'report:security'  => $reportSecurity(),
    'jwt:keygen'       => $jwtKeygen($argv),
    'operator:create'  => $operatorCreate($argv),
    'list', '--help', '-h' => $usage(),
    default            => (static function (string $c): int {
        fwrite(STDERR, "알 수 없는 커맨드: {$c}\n실행 가능한 커맨드는 `php bin/console list` 로 확인하세요.\n");

        return 1;
    })($command),
};

exit($exitCode);
